}

.detail-table span {
  font-size: 11px !important;
}

.detail-table strong {
  font-size: 12px !important;
}

/* Hide lower list to keep dashboard close to reference */

.list-section {
  display: none !important;
}

/* Use laptop space better */

@media (max-width: 1500px) {
  .dashboard-layout {
    grid-template-columns: 250px minmax(0, 1fr) 300px !important;
    gap: 10px !important;
  }

  .cluster-canvas {
