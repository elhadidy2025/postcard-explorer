  }

  .journey-section {
    grid-column: 2 !important;
  }
}

/* === MAP SPAN RIGHT COLUMN END === */

/* === NICE MAP STYLE START === */

/* Cleaner, more presentation-friendly map */

.journey-section {
  background: rgba(255, 255, 255, 0.98) !important;
}

.journey-map-wrap {
  border-radius: 20px !important;
  overflow: hidden !important;
  border: 1px solid #d7e2f0 !important;
  background: linear-gradient(135deg, #eaf4ff, #f8fbff) !important;
  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,0.7),
    0 14px 32px rgba(15, 23, 42, 0.10) !important;
}

/* Make the CARTO Voyager tiles a bit more vivid */
.journey-map-wrap .leaflet-tile {
  filter: saturate(1.15) contrast(1.04) brightness(1.02);
}

/* Softer route rendering */
.journey-map-wrap .leaflet-overlay-pane svg path {
  stroke-linecap: round !important;
  stroke-linejoin: round !important;
  filter: drop-shadow(0 1px 1px rgba(15, 23, 42, 0.18));
}

/* Better zoom buttons */
.journey-map-wrap .leaflet-control-zoom {
  border: none !important;
  border-radius: 14px !important;
  overflow: hidden !important;
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.18) !important;
}

.journey-map-wrap .leaflet-control-zoom a {
  width: 34px !important;
  height: 34px !important;
  line-height: 32px !important;
  border: none !important;
  background: rgba(255, 255, 255, 0.96) !important;
  color: #0f172a !important;
  font-size: 21px !important;
  font-weight: 800 !important;
}

.journey-map-wrap .leaflet-control-zoom a:hover {
  background: #eff6ff !important;
  color: #2563eb !important;
}

/* Cleaner attribution */
.journey-map-wrap .leaflet-control-attribution {
  background: rgba(255, 255, 255, 0.82) !important;
  backdrop-filter: blur(6px);
  border-radius: 8px 0 0 0 !important;
  color: #334155 !important;
  font-size: 10px !important;
}

/* Cleaner popups */
.journey-map-wrap .leaflet-popup-content-wrapper {
  border-radius: 16px !important;
  box-shadow: 0 18px 38px rgba(15, 23, 42, 0.22) !important;
}

.journey-map-wrap .leaflet-popup-tip {
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.18) !important;
}

.route-popup img {
  border-radius: 12px !important;
  background: #f8fafc !important;
  border: 1px solid #e5e7eb !important;
}

/* Keep unnecessary overlay hidden */
.map-overlay-legend {
  display: none !important;
}

/* === NICE MAP STYLE END === */

/* === BETTER CLUSTER MAP DESIGN START === */

/* Better Image Cluster Map design */

.cluster-section {
  background: rgba(255, 255, 255, 0.98) !important;
  border-radius: 20px !important;
  overflow: hidden !important;
}

.cluster-canvas {
  min-height: 300px !important;
  display: grid !important;
  grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
  gap: 12px !important;
  padding: 14px !important;
  border-radius: 18px !important;
  background:
    radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.08), transparent 28%),
    radial-gradient(circle at 80% 20%, rgba(34, 197, 94, 0.08), transparent 26%),
    radial-gradient(circle at 45% 85%, rgba(236, 72, 153, 0.07), transparent 28%),
    linear-gradient(135deg, #fbfdff, #f8fafc) !important;
}

/* Card instead of empty oval */

.topic-bubble {
  position: relative !important;
  min-height: 128px !important;
  padding: 12px !important;
  border-radius: 22px !important;
  border: 1px solid #e5e7eb !important;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.96), rgba(248,250,252,0.92)) !important;
  box-shadow:
    0 10px 22px rgba(15, 23, 42, 0.08),
    inset 0 0 0 1px rgba(255,255,255,0.65) !important;
  overflow: hidden !important;
  text-align: left !important;
}

.topic-bubble::before {
  content: "";
  position: absolute;
  inset: 0 auto 0 0;
  width: 5px;
  background: var(--cluster-color, #2563eb);
  opacity: 0.85;
}

.topic-bubble:hover {
  transform: translateY(-3px) !important;
  box-shadow:
    0 16px 32px rgba(15, 23, 42, 0.14),
    inset 0 0 0 1px rgba(255,255,255,0.8) !important;
}

.topic-bubble.selected {
  background: #eff6ff !important;
  border-color: #2563eb !important;
  outline: 3px solid rgba(37, 99, 235, 0.18) !important;
}

/* Cleaner title */

.topic-title {
  display: grid !important;
  grid-template-columns: 12px 1fr !important;
  align-items: start !important;
  gap: 8px !important;
  justify-content: start !important;
  text-align: left !important;
  margin-bottom: 9px !important;
  padding-left: 3px !important;
}

.topic-title .topic-dot {
  width: 10px !important;
  height: 10px !important;
  margin-top: 2px !important;
}

.topic-title h3 {
  margin: 0 !important;
  font-size: 12px !important;
  line-height: 1.15 !important;
  font-weight: 900 !important;
  color: #0f172a !important;
  max-width: 100% !important;
}

.topic-title p {
  margin: 3px 0 0 !important;
  font-size: 12px !important;
  font-weight: 900 !important;
  color: #475569 !important;
}

/* Better image mosaic */

.topic-image-cloud {
  display: grid !important;
  grid-template-columns: repeat(3, 1fr) !important;
  gap: 7px !important;
  max-width: none !important;
  width: 100% !important;
  margin: 0 !important;
  padding-left: 5px !important;
}

.topic-image-cloud img {
  width: 100% !important;
  height: 43px !important;
  object-fit: cover !important;
  border-radius: 9px !important;
  border: 2px solid white !important;
  box-shadow: 0 5px 12px rgba(15, 23, 42, 0.18) !important;
  background: #f8fafc !important;
}

/* If a cluster has few images, keep the card still balanced */
.topic-image-cloud img:only-child {
  grid-column: 1 / 3 !important;
  width: 100% !important;
  height: 62px !important;
}

/* Film strip under the cluster map */

.cluster-members-bar {
  margin-top: 10px !important;
  border-radius: 16px !important;
  background: rgba(248, 250, 252, 0.98) !important;
  border: 1px solid #e5e7eb !important;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.7) !important;
}

.cluster-member-strip button {
  border-radius: 10px !important;
  overflow: hidden !important;
  background: white !important;
}

.cluster-member-strip button.selected {
  border-color: #7c3aed !important;
  box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.18) !important;
}

.cluster-member-strip img {
  border-radius: 8px !important;
}

/* Responsive adjustment */

@media (max-width: 1500px) {
  .cluster-canvas {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 10px !important;
  }

  .topic-bubble {
    min-height: 116px !important;
    padding: 10px !important;
  }

  .topic-title h3 {
    font-size: 11px !important;
  }

  .topic-image-cloud {
    gap: 5px !important;
  }

  .topic-image-cloud img {
    height: 35px !important;
  }
}

@media (max-width: 1100px) {
  .cluster-canvas {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
}

/* === BETTER CLUSTER MAP DESIGN END === */

/* === COMPACT CLUSTERS MORE MAP START === */

/* Compact cluster map + more space for travel map */

.cluster-section {
  padding: 10px 12px !important;
  min-height: auto !important;
}

.cluster-section .section-header {
  margin-bottom: 6px !important;
}

.cluster-section .section-header h2 {
  font-size: 15px !important;
}

.cluster-section .section-header p {
  font-size: 11px !important;
}

/* 12 clusters in 2 compact rows */

.cluster-canvas {
  min-height: 190px !important;
  height: auto !important;
  max-height: 220px !important;
  grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
  gap: 7px !important;
  padding: 8px !important;
  border-radius: 16px !important;
  overflow: hidden !important;
  background:
    radial-gradient(circle at 20% 25%, rgba(59, 130, 246, 0.08), transparent 25%),
    radial-gradient(circle at 80% 30%, rgba(34, 197, 94, 0.08), transparent 25%),
    linear-gradient(135deg, #fbfdff, #f8fafc) !important;
}

/* Compact clean topic card */

.topic-bubble {
  min-height: 82px !important;
  height: 82px !important;
  padding: 7px 8px !important;
  border-radius: 18px !important;
  border: 1px solid #dbe3ef !important;
  background: rgba(255, 255, 255, 0.94) !important;
  box-shadow: 0 6px 15px rgba(15, 23, 42, 0.07) !important;
  overflow: hidden !important;
}

.topic-bubble::before {
  width: 4px !important;
}

.topic-bubble:hover,
.topic-bubble.selected {
  transform: translateY(-2px) !important;
  box-shadow: 0 10px 22px rgba(15, 23, 42, 0.12) !important;
}

.topic-bubble.selected {
  background: #eff6ff !important;
  outline: 2px solid rgba(37, 99, 235, 0.18) !important;
}

/* Smaller title */

.topic-title {
  display: grid !important;
  grid-template-columns: 9px 1fr !important;
  gap: 5px !important;
  margin-bottom: 5px !important;
  padding-left: 1px !important;
  text-align: left !important;
}

.topic-title .topic-dot {
  width: 8px !important;
  height: 8px !important;
  margin-top: 2px !important;
}

.topic-title h3 {
  font-size: 9.5px !important;
  line-height: 1.08 !important;
  font-weight: 900 !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
}

.topic-title p {
  font-size: 10px !important;
  margin-top: 1px !important;
  font-weight: 900 !important;
}

/* Only 3 thumbnails per cluster */

.topic-image-cloud {
  display: flex !important;
  justify-content: center !important;
  gap: 5px !important;
  width: 100% !important;
  max-width: none !important;
  padding-left: 0 !important;
  margin: 0 !important;
}

.topic-image-cloud img {
  width: 34px !important;
  height: 26px !important;
  object-fit: cover !important;
  border-radius: 6px !important;
  border: 2px solid white !important;
  box-shadow: 0 4px 10px rgba(15, 23, 42, 0.18) !important;
}

/* Make selected cluster strip shorter */

.cluster-members-bar {
  margin-top: 7px !important;
  min-height: 42px !important;
  grid-template-columns: 190px auto 1fr !important;
  padding: 5px 8px !important;
  border-radius: 14px !important;
}

.cluster-members-bar h3 {
  font-size: 12px !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
}

.cluster-members-bar p {
  font-size: 10px !important;
