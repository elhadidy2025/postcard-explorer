  border-radius: 12px;
  background: #eff6ff;
  border: 1px solid #bfdbfe;
}

.active-search-note span {
  display: block;
  color: #1d4ed8;
  font-size: 11px;
  font-weight: 900;
  margin-bottom: 3px;
}

.active-search-note strong {
  display: block;
  color: #0f172a;
  font-size: 13px;
  margin-bottom: 8px;
  word-break: break-word;
}

.active-search-note button {
  width: 100%;
  height: 30px;
  border: none;
  border-radius: 9px;
  background: #2563eb;
  color: white;
  font-size: 11px;
  font-weight: 900;
}

/* === E1 GLOBAL SEARCH STYLE END === */

/* === E2 OUTLIER EXPLORER STYLE START === */

.outlier-section {
  grid-column: 2 / 4 !important;
  grid-row: 3 !important;
  padding: 12px !important;
  border-radius: 18px !important;
}

.outlier-header {
  margin-bottom: 10px !important;
}

.outlier-threshold-control {
  display: grid;
  gap: 4px;
  min-width: 145px;
}

.outlier-threshold-control label {
  font-size: 11px;
  color: #64748b;
  font-weight: 900;
}

.outlier-threshold-control select {
  height: 34px;
  border: 1px solid #dbe3ef;
  border-radius: 10px;
  background: white;
  color: #0f172a;
  font-weight: 900;
  padding: 0 9px;
}

.outlier-summary {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 10px;
  padding: 10px 12px;
  border-radius: 12px;
  background: #fff7ed;
  border: 1px solid #fed7aa;
}

.outlier-summary strong {
  color: #ea580c;
  font-size: 22px;
}

.outlier-summary span {
  color: #7c2d12;
  font-size: 12px;
  font-weight: 800;
}

.outlier-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.outlier-card {
  display: grid;
  grid-template-columns: 72px 1fr;
  gap: 9px;
  align-items: center;
  text-align: left;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  background: white;
  padding: 8px;
  transition: 0.18s ease;
}

.outlier-card:hover,
.outlier-card.selected {
  border-color: #f97316;
  background: #fff7ed;
  transform: translateY(-2px);
}

.outlier-card img {
  width: 72px;
  height: 58px;
  object-fit: cover;
  border-radius: 10px;
  background: #f8fafc;
}

.outlier-card-body {
  display: grid;
  gap: 4px;
  min-width: 0;
}

.outlier-card-top {
  display: flex;
  justify-content: space-between;
  gap: 6px;
  align-items: center;
}

.outlier-card-top strong {
  color: #0f172a;
  font-size: 12px;
}

.outlier-card-top span {
  color: #ea580c;
  background: #ffedd5;
  border-radius: 999px;
  padding: 3px 6px;
  font-size: 10px;
  font-weight: 900;
}

.outlier-card p {
  margin: 0;
  color: #7c2d12;
  font-size: 11px;
  font-weight: 900;
}

.outlier-card small {
  color: #64748b;
  font-size: 10.5px;
}

@media (max-width: 1500px) {
  .outlier-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 1100px) {
  .outlier-section {
    grid-column: 1 !important;
  }

  .outlier-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* === E2 OUTLIER EXPLORER STYLE END === */

/* === E3 SEMANTIC ZOOM STYLE START === */

.cluster-zoom-control {
  display: grid;
  gap: 4px;
  justify-items: end;
}

.cluster-zoom-control > span {
  color: #64748b;
  font-size: 11px;
  font-weight: 900;
}

.cluster-zoom-control div {
  display: flex;
  gap: 5px;
}

.cluster-zoom-control button {
  width: 25px;
  height: 25px;
  border: 1px solid #dbe3ef;
  border-radius: 8px;
  background: white;
  color: #334155;
  font-size: 11px;
  font-weight: 900;
}

.cluster-zoom-control button.active,
.cluster-zoom-control button:hover {
  background: #2563eb;
  color: white;
  border-color: #2563eb;
}

.cluster-zoom-control small {
  color: #64748b;
  font-size: 10px;
  font-weight: 800;
}

/* Cluster semantic zoom levels */

.cluster-zoom-1 .topic-bubble {
  height: 66px !important;
  min-height: 66px !important;
}

.cluster-zoom-1 .topic-image-cloud img {
  width: 42px !important;
  height: 30px !important;
}

.cluster-zoom-2 .topic-bubble {
  height: 78px !important;
  min-height: 78px !important;
}

.cluster-zoom-3 .topic-bubble {
  height: 98px !important;
  min-height: 98px !important;
}

.cluster-zoom-3 .topic-image-cloud {
  flex-wrap: wrap !important;
}

.cluster-zoom-3 .topic-image-cloud img {
  width: 34px !important;
  height: 25px !important;
}

/* Map semantic zoom note */

.map-semantic-zoom-note {
  display: grid;
  gap: 3px;
  min-width: 145px;
  padding: 7px 10px;
  border-radius: 12px;
  background: #f8fafc;
  border: 1px solid #e5e7eb;
}

.map-semantic-zoom-note span {
  color: #64748b;
  font-size: 10.5px;
  font-weight: 900;
}

.map-semantic-zoom-note strong {
  color: #0f172a;
  font-size: 13px;
  font-weight: 900;
}

.map-semantic-zoom-note small {
  color: #2563eb;
  font-size: 10px;
  font-weight: 800;
}

/* Make route changes smoother while zooming */

.journey-map-wrap .leaflet-overlay-pane svg path {
  transition: stroke-width 0.18s ease, opacity 0.18s ease;
}

/* === E3 SEMANTIC ZOOM STYLE END === */
