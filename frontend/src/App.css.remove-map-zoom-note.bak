}

.route-map,
.journey-map-wrap .leaflet-container {
  height: 430px !important;
  min-height: 430px !important;
  width: 100% !important;
}

.leaflet-control-attribution {
  font-size: 10px !important;
}

/* Keep right detail panel compact */

.detail-panel {
  width: 100% !important;
}

.detail-image {
  max-height: 215px !important;
}

.detail-table {
  gap: 10px !important;
}

.detail-table div {
