}

.topic-image-cloud img {
  width: 48px !important;
  height: 37px !important;
  border-radius: 7px !important;
  box-shadow: 0 5px 12px rgba(15, 23, 42, 0.25) !important;
}

/* Cluster member strip like bottom film strip */

.cluster-members-bar {
  grid-template-columns: 245px auto 1fr !important;
  margin-top: 10px !important;
  padding: 9px 11px !important;
  border-radius: 16px !important;
  background: rgba(248, 250, 252, 0.95) !important;
}

.cluster-member-strip button {
  width: 58px !important;
  height: 43px !important;
  border-radius: 9px !important;
}

.cluster-member-strip button.selected {
  border-color: #7c3aed !important;
  box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.18);
}

/* Map closer to the reference */

.journey-section {
  padding: 14px !important;
}

.journey-map-wrap {
  height: 405px !important;
