/* === FINAL WIDE MAP + SHORT CLUSTERS END === */

/* === MAP SPAN RIGHT COLUMN START === */

/* Make Postcard Journeys span under the Selected Postcard panel */

.dashboard-layout {
  display: grid !important;
  grid-template-columns: 270px minmax(0, 1fr) 315px !important;
  grid-template-rows: auto auto !important;
  gap: 12px !important;
  align-items: start !important;
  width: 100% !important;
}

/* Let workspace children participate in the main dashboard grid */
.workspace {
  display: contents !important;
}

/* Left filter stays on the left side */
.filters-panel {
  grid-column: 1 !important;
  grid-row: 1 / 3 !important;
  position: sticky !important;
  top: 12px !important;
  align-self: start !important;
}

/* Cluster map only in the center top */
.cluster-section {
  grid-column: 2 !important;
  grid-row: 1 !important;
  min-height: auto !important;
  padding: 12px !important;
}

/* Selected postcard stays top-right only */
.detail-panel {
  grid-column: 3 !important;
  grid-row: 1 !important;
  position: sticky !important;
  top: 12px !important;
  align-self: start !important;
  max-height: none !important;
  min-height: 0 !important;
}

/* Journey map becomes wide: center + right column */
.journey-section {
  grid-column: 2 / 4 !important;
  grid-row: 2 !important;
  padding: 12px !important;
  width: 100% !important;
}

/* Keep list hidden for presentation dashboard */
.list-section {
  display: none !important;
}

/* Shorter cluster area */
.cluster-canvas {
  min-height: 300px !important;
  grid-template-columns: repeat(4, 1fr) !important;
  gap: 8px !important;
  padding: 9px !important;
}

.topic-bubble {
