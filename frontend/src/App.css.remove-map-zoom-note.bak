}

.route-map,
.journey-map-wrap .leaflet-container {
  height: 460px !important;
  min-height: 460px !important;
  width: 100% !important;
}

/* Compact right panel */
.detail-image {
  max-height: 205px !important;
}

.detail-table {
  gap: 9px !important;
}

.detail-actions {
  margin-top: 14px !important;
}

/* Better behavior on smaller laptop widths */
@media (max-width: 1500px) {
  .dashboard-layout {
    grid-template-columns: 250px minmax(0, 1fr) 300px !important;
    gap: 10px !important;
  }

  .cluster-canvas {
    min-height: 285px !important;
  }

