/* =========================================================================
   Postcard Explorer — Design Tokens
   A warm "sorted mail" palette: paper background, postal-ink text,
   a terracotta stamp accent for interactive state. Cluster colors are
   data encoding, not decoration, and are left as-is but used consistently.
   ========================================================================= */

:root {
  --paper: #faf7f2;
  --paper-raised: #ffffff;
  --ink: #1e2a38;
  --ink-soft: #5b6a7a;
  --ink-faint: #8a96a3;
  --line: #e4ddd0;
  --line-soft: #ece6da;
  --stamp: #c1622d;
  --stamp-soft: #f3e3d8;
  --stamp-dark: #a8501f;
  --accent-blue: #2f5d8a;
  --accent-blue-soft: #e8eff6;
  --shadow-sm: 0 1px 2px rgba(30, 42, 56, 0.06);
  --shadow-md: 0 6px 18px rgba(30, 42, 56, 0.08);
  --shadow-lg: 0 16px 40px rgba(30, 42, 56, 0.12);
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 18px;
  --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font);
  -webkit-font-smoothing: antialiased;
}

button,
input,
select {
  font-family: inherit;
}

button {
  cursor: pointer;
}

button:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 2px solid var(--stamp);
  outline-offset: 2px;
}

/* =========================================================================
   Shell
   ========================================================================= */

.app-shell {
  width: 100%;
  min-height: 100vh;
  padding: 20px 24px 32px;
}

/* =========================================================================
   Top bar
   ========================================================================= */

.topbar {
  display: grid;
  grid-template-columns: 1.1fr 2.4fr;
  gap: 20px;
  align-items: center;
  margin-bottom: 18px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-icon {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: var(--paper-raised);
  border: 2px dashed var(--stamp);
  color: var(--stamp);
  font-size: 20px;
  flex-shrink: 0;
}

.brand h1 {
  margin: 0;
  font-size: 26px;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.3px;
  color: var(--ink);
}

.brand p {
  margin: 5px 0 0;
  color: var(--ink-soft);
  font-weight: 600;
  font-size: 13px;
  letter-spacing: 0.02em;
}

.top-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.top-stat {
  display: flex;
  gap: 11px;
  align-items: center;
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 12px 14px;
  box-shadow: var(--shadow-sm);
}

.stat-icon {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-sm);
  display: grid;
  place-items: center;
  font-size: 16px;
  font-weight: 900;
  flex-shrink: 0;
}

.stat-icon.blue {
  background: var(--accent-blue-soft);
  color: var(--accent-blue);
}

.stat-icon.green {
  background: #e7f3e8;
  color: #2f7a3d;
}

.stat-icon.purple {
  background: #efe7f6;
  color: #6b3fa0;
}

.stat-icon.orange {
  background: var(--stamp-soft);
  color: var(--stamp);
}

.top-stat p {
  margin: 0 0 2px;
  color: var(--ink-soft);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.top-stat strong {
  font-size: 18px;
  font-weight: 800;
  color: var(--ink);
}

/* =========================================================================
   Main layout — three real columns, no overlap/floating tricks
   ========================================================================= */

.dashboard-layout {
  display: grid;
  grid-template-columns: 264px minmax(0, 1fr) 300px;
  gap: 16px;
  align-items: start;
}

.workspace {
  display: grid;
  gap: 16px;
  min-width: 0;
}

.card,
.filters-panel,
.detail-panel {
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.card {
  padding: 16px;
}

.filters-panel,
.detail-panel {
  position: sticky;
  top: 20px;
  max-height: calc(100vh - 40px);
  overflow: auto;
  padding: 16px;
}

.filters-panel::-webkit-scrollbar,
.detail-panel::-webkit-scrollbar,
.list-section::-webkit-scrollbar {
  width: 6px;
}

.filters-panel::-webkit-scrollbar-thumb,
.detail-panel::-webkit-scrollbar-thumb,
.list-section::-webkit-scrollbar-thumb {
  background: var(--line);
  border-radius: 4px;
}

.panel-title,
.section-header,
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}

.panel-title h2,
.section-header h2,
.detail-header h2 {
  margin: 0;
  font-size: 15px;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.1px;
}

.section-header p {
  margin: 3px 0 0;
  color: var(--ink-soft);
  font-size: 12px;
  font-weight: 600;
}

.info-dot {
  width: 18px;
  height: 18px;
  border: 1px solid var(--line);
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--ink-faint);
  font-size: 11px;
  flex-shrink: 0;
}

/* =========================================================================
   Filters panel
   ========================================================================= */

.filters-panel label {
  display: block;
  margin: 16px 0 6px;
  color: var(--ink-soft);
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.filters-panel label:first-of-type {
  margin-top: 14px;
}

.filters-panel input,
.filters-panel select {
  width: 100%;
  height: 36px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper);
  color: var(--ink);
  padding: 0 11px;
  font-size: 13px;
  outline: none;
  transition: border-color 0.15s ease;
}

.filters-panel input:focus,
.filters-panel select:focus {
  border-color: var(--stamp);
  background: var(--paper-raised);
}

.search-box {
  position: relative;
}

.search-box input {
  padding-right: 34px;
}

.search-box span {
  position: absolute;
  right: 11px;
  top: 9px;
  color: var(--ink-faint);
  font-size: 14px;
}

.date-row,
.distance-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

/* E1: global search helper chips */

.e1-search-help {
  margin-top: 9px;
  padding: 10px;
  border-radius: var(--radius-sm);
  background: var(--paper);
  border: 1px solid var(--line-soft);
}

.e1-search-help p {
  margin: 0 0 8px;
  color: var(--ink-soft);
  font-size: 11px;
  line-height: 1.4;
  font-weight: 600;
}

.e1-search-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.e1-search-chips button {
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--paper-raised);
  color: var(--ink-soft);
  padding: 5px 9px;
  font-size: 11px;
  font-weight: 700;
  transition: 0.15s ease;
}

.e1-search-chips button:hover {
  background: var(--stamp-soft);
  color: var(--stamp-dark);
  border-color: var(--stamp);
}

.active-search-note {
  margin-top: 12px;
  padding: 11px;
  border-radius: var(--radius-sm);
  background: var(--accent-blue-soft);
  border: 1px solid #c7d9ea;
}

.active-search-note span {
  display: block;
  color: var(--accent-blue);
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 3px;
}

.active-search-note strong {
  display: block;
  color: var(--ink);
  font-size: 13px;
  margin-bottom: 9px;
  word-break: break-word;
}

.active-search-note button {
  width: 100%;
  height: 30px;
  border: none;
  border-radius: var(--radius-sm);
  background: var(--accent-blue);
  color: white;
  font-size: 11px;
  font-weight: 800;
}

/* Topic / cluster filter list */

.topic-filter-list {
  display: grid;
  gap: 4px;
  max-height: 200px;
  overflow: auto;
  padding-right: 2px;
}

.topic-filter-list button {
  display: grid;
  grid-template-columns: 12px 1fr auto;
  gap: 8px;
  align-items: center;
  min-height: 30px;
  border: none;
  background: transparent;
  border-radius: var(--radius-sm);
  padding: 5px 7px;
  color: var(--ink-soft);
  text-align: left;
  font-size: 12px;
  font-weight: 600;
}

.topic-filter-list button:hover {
  background: var(--line-soft);
}

.topic-filter-list button.active {
  background: var(--stamp-soft);
  color: var(--stamp-dark);
}

.topic-filter-list strong {
  color: var(--ink-faint);
  font-size: 11px;
  font-weight: 800;
}

.topic-filter-list button.active strong {
  color: var(--stamp-dark);
}

.topic-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
  box-shadow: 0 0 0 2px var(--paper-raised);
}

.active-cluster-note {
  margin-top: 12px;
  padding: 11px;
  border-radius: var(--radius-sm);
  background: var(--stamp-soft);
  border: 1px solid #e8c2a8;
}

.active-cluster-note p {
  margin: 0 0 9px;
  font-size: 12px;
  color: var(--stamp-dark);
  line-height: 1.4;
}

.active-cluster-note button,
.clear-button {
  width: 100%;
  height: 34px;
  border: none;
  border-radius: var(--radius-sm);
  color: white;
  font-weight: 800;
  font-size: 12px;
}

.active-cluster-note button {
  background: var(--stamp);
}

.clear-button {
  margin-top: 16px;
  background: var(--ink);
}

/* E4: topic hierarchy tree, lives in the filter sidebar */

.topic-hierarchy-card {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}

.topic-hierarchy-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

.topic-hierarchy-head span {
  display: inline-block;
  margin-bottom: 3px;
  color: var(--accent-blue);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.topic-hierarchy-head h3 {
  margin: 0;
  color: var(--ink);
  font-size: 13px;
  font-weight: 800;
}

.topic-hierarchy-head button {
  height: 26px;
  padding: 0 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--paper);
  color: var(--ink-soft);
  font-size: 10.5px;
  font-weight: 800;
}

.topic-hierarchy-head button:hover {
  background: var(--ink);
  color: white;
  border-color: var(--ink);
}

.topic-hierarchy-intro {
  margin: 0 0 10px;
  color: var(--ink-faint);
  font-size: 11px;
  line-height: 1.4;
  font-weight: 600;
}

.topic-tree {
  display: grid;
  gap: 6px;
}

.topic-tree-group {
  border: 1px solid var(--line-soft);
  border-radius: 10px;
  background: var(--paper);
  overflow: hidden;
}

.topic-tree-group.active {
  border-color: var(--stamp);
  background: var(--stamp-soft);
}

.topic-tree-group summary {
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  padding: 9px 10px;
}

.topic-tree-group summary::-webkit-details-marker {
  display: none;
}

.topic-tree-group summary span {
  color: var(--ink);
  font-size: 11.5px;
  font-weight: 800;
}

.topic-tree-group summary strong {
  color: var(--stamp-dark);
  font-size: 11px;
  font-weight: 800;
}

.topic-tree-group small {
  display: block;
  padding: 0 10px 8px;
  color: var(--ink-faint);
  font-size: 10px;
  line-height: 1.4;
  font-weight: 600;
}

.topic-tree-children {
  display: grid;
  gap: 5px;
  padding: 0 8px 9px;
}

.topic-tree-leaf {
  display: grid;
  grid-template-columns: 8px 1fr auto;
  align-items: center;
  gap: 7px;
  width: 100%;
  text-align: left;
  border: 1px solid var(--line-soft);
  border-radius: 8px;
  background: var(--paper-raised);
  padding: 7px 8px;
  transition: 0.15s ease;
}

.topic-tree-leaf:hover {
  border-color: var(--stamp);
}

.topic-tree-leaf.selected {
  border-color: var(--stamp);
  background: var(--stamp-soft);
}

.topic-tree-color {
  width: 7px;
  height: 7px;
  border-radius: 999px;
}

.topic-tree-name {
  min-width: 0;
  color: var(--ink-soft);
  font-size: 10.5px;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.topic-tree-leaf strong {
  color: var(--ink);
  font-size: 10.5px;
  font-weight: 800;
}

/* Result count */

.result-card {
  margin-top: 16px;
  padding: 14px;
  border-radius: var(--radius-md);
  background: var(--ink);
  text-align: left;
}

.result-card span {
  display: block;
  color: rgba(255, 255, 255, 0.6);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.result-card strong {
  display: block;
  margin-top: 4px;
  font-size: 26px;
  font-weight: 800;
  color: white;
}

.result-card p {
  margin: 2px 0 0;
  color: rgba(255, 255, 255, 0.55);
  font-size: 12px;
}

/* =========================================================================
   Cluster section (M2) — compact card grid, plus E3 semantic zoom control
   ========================================================================= */

.cluster-section {
  padding: 16px;
}

.cluster-zoom-control {
  display: grid;
  gap: 4px;
  justify-items: end;
  flex-shrink: 0;
}

.cluster-zoom-control > span {
  color: var(--ink-soft);
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.cluster-zoom-control div {
  display: flex;
  gap: 4px;
}

.cluster-zoom-control button {
  width: 26px;
  height: 26px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper);
  color: var(--ink-soft);
  font-size: 11px;
  font-weight: 800;
}

.cluster-zoom-control button.active,
.cluster-zoom-control button:hover {
  background: var(--stamp);
  color: white;
  border-color: var(--stamp);
}

.cluster-zoom-control small {
  color: var(--ink-faint);
  font-size: 10px;
  font-weight: 700;
}

.cluster-canvas {
  margin-top: 12px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 11px;
  max-height: 420px;
  overflow: auto;
  padding: 4px 4px 4px 0;
}

.topic-bubble {
  position: relative;
  height: 168px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper-raised);
  padding: 0;
  text-align: left;
  transition: 0.18s ease;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.topic-bubble::before {
  content: none;
}

.topic-bubble:hover {
  border-color: var(--cluster-color, var(--ink-faint));
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.topic-bubble.selected {
  border-color: var(--cluster-color, var(--stamp));
  border-width: 2px;
  box-shadow: var(--shadow-md);
}

/* Hero image stack: the dominant sample sits on top of two
   peeking thumbnails, so the card reads as a stack of postcards
   rather than a single flat thumbnail. */

.topic-image-cloud {
  position: relative;
  flex: 1;
  min-height: 0;
  background: var(--paper);
  overflow: visible;
  padding: 0;
}

.topic-image-cloud img {
  position: absolute;
  border-radius: 5px;
  border: 2px solid var(--paper-raised);
  box-shadow: 0 3px 8px rgba(30, 42, 56, 0.18);
  object-fit: cover;
  background: var(--paper);
}

/* Hero (first) image: fills the card top */
.topic-image-cloud img:first-child {
  position: static;
  width: 100%;
  height: 100%;
  border-radius: 0;
  border: none;
  box-shadow: none;
}

/* Two supporting thumbnails peek out from behind the hero,
   bottom corners, like a fanned stack of postcards. */
.topic-image-cloud img:nth-child(2) {
  width: 34%;
  height: 46%;
  bottom: -8px;
  left: -6px;
  transform: rotate(-9deg);
}

.topic-image-cloud img:nth-child(3) {
  width: 34%;
  height: 46%;
  bottom: -8px;
  right: -6px;
  transform: rotate(8deg);
}

.topic-image-cloud img:nth-child(n + 4) {
  display: none;
}

/* Caption strip */

.topic-title {
  display: grid;
  grid-template-columns: 8px 1fr;
  align-items: start;
  gap: 7px;
  padding: 8px 10px;
  text-align: left;
  background: var(--paper-raised);
  border-top: 1px solid var(--line-soft);
}

.topic-title .topic-dot {
  width: 8px;
  height: 8px;
  margin-top: 3px;
}

.topic-title h3 {
  margin: 0;
  font-size: 11px;
  line-height: 1.25;
  font-weight: 800;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.topic-title p {
  margin: 2px 0 0;
  color: var(--ink-soft);
  font-size: 10px;
  font-weight: 700;
}

/* Semantic zoom levels (E3) */

.cluster-zoom-1 .topic-bubble {
  height: 168px;
}

.cluster-zoom-2 .topic-bubble {
  height: 196px;
}

.cluster-zoom-3 .topic-bubble {
  height: 230px;
}

.cluster-zoom-3 .topic-image-cloud img:nth-child(2),
.cluster-zoom-3 .topic-image-cloud img:nth-child(3) {
  width: 30%;
  height: 38%;
}

.cluster-zoom-3 .topic-image-cloud img:nth-child(4) {
  display: block;
  width: 26%;
  height: 32%;
  top: 6%;
  right: 4%;
  transform: rotate(6deg);
}



/* Selected cluster filmstrip */

.cluster-members-bar {
  margin-top: 12px;
  display: grid;
  grid-template-columns: 200px auto 1fr;
  gap: 10px;
  align-items: center;
  padding: 10px 12px;
  border-radius: var(--radius-md);
  background: var(--paper);
  border: 1px solid var(--line-soft);
}

.cluster-members-bar h3 {
  margin: 0;
  font-size: 12.5px;
  font-weight: 800;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cluster-members-bar p {
  margin: 2px 0 0;
  color: var(--ink-soft);
  font-size: 10.5px;
  font-weight: 600;
}

.cluster-member-actions {
  display: flex;
  gap: 5px;
}

.cluster-member-actions button {
  width: 27px;
  height: 27px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper-raised);
  color: var(--ink);
  font-size: 16px;
  line-height: 1;
}

.cluster-member-actions button:hover:not(:disabled) {
  border-color: var(--stamp);
  color: var(--stamp);
}

.cluster-member-actions button:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.cluster-member-strip {
  display: flex;
  gap: 6px;
  overflow: auto;
  padding-bottom: 2px;
}

.cluster-member-strip button {
  flex: 0 0 auto;
  width: 44px;
  height: 34px;
  border: 2px solid transparent;
  border-radius: 7px;
  background: var(--paper-raised);
  padding: 0;
  overflow: hidden;
}

.cluster-member-strip button.selected {
  border-color: var(--stamp);
}

.cluster-member-strip img {
  width: 100%;
  height: 100%;
  border-radius: 5px;
  object-fit: cover;
}

/* =========================================================================
   Journey map (M3)
   ========================================================================= */

.journey-section {
  padding: 16px;
}

.map-title-row {
  margin-bottom: 10px;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

.map-semantic-zoom-note {
  display: grid;
  gap: 2px;
  min-width: 120px;
  padding: 7px 11px;
  border-radius: var(--radius-sm);
  background: var(--paper);
  border: 1px solid var(--line-soft);
}

.map-semantic-zoom-note span {
  color: var(--ink-faint);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.map-semantic-zoom-note strong {
  color: var(--ink);
  font-size: 12.5px;
  font-weight: 800;
}

.map-semantic-zoom-note small {
  color: var(--accent-blue);
  font-size: 10px;
  font-weight: 700;
}

.route-limit-control {
  display: grid;
  gap: 4px;
  min-width: 120px;
}

.route-limit-control label {
  font-size: 10.5px;
  font-weight: 800;
  color: var(--ink-soft);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.route-limit-control select {
  height: 34px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper);
  color: var(--ink);
  font-weight: 700;
  font-size: 12.5px;
  padding: 0 9px;
}

.journey-map-wrap {
  position: relative;
  height: 460px;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--line);
  background: #e9eef2;
}

.route-map,
.journey-map-wrap .leaflet-container {
  width: 100% !important;
  height: 460px !important;
  min-height: 460px;
  display: block;
}

.leaflet-container {
  font-family: var(--font);
  background: #eef3f6;
}

.leaflet-tile {
  filter: saturate(0.9) contrast(1.02);
}

.leaflet-control-zoom {
  border: none !important;
  border-radius: var(--radius-sm) !important;
  overflow: hidden;
  box-shadow: var(--shadow-md) !important;
}

.leaflet-control-zoom a {
  border: none !important;
  color: var(--ink) !important;
}

.leaflet-popup-content-wrapper {
  border-radius: var(--radius-md) !important;
  box-shadow: var(--shadow-lg) !important;
}

.route-popup {
  width: 190px;
}

.route-popup img {
  width: 100%;
  max-height: 115px;
  object-fit: contain;
  background: var(--paper);
  border-radius: var(--radius-sm);
  margin-bottom: 8px;
}

.route-popup p {
  margin: 4px 0;
  font-size: 12px;
}

.map-overlay-legend {
  position: absolute;
  right: 12px;
  bottom: 12px;
  z-index: 450;
  width: 200px;
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 10px;
  box-shadow: var(--shadow-md);
}

.map-overlay-legend strong {
  display: block;
  font-size: 11.5px;
  margin-bottom: 7px;
  color: var(--ink);
}

.map-overlay-legend div {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

.map-overlay-legend span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--ink-soft);
  font-size: 10.5px;
}

.map-overlay-legend i {
  width: 11px;
  height: 3px;
  display: inline-block;
  border-radius: 999px;
  flex-shrink: 0;
}

.direction-legend {
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid var(--line-soft);
}

.direction-legend .origin-dot,
.direction-legend .receiving-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
}

.direction-legend .origin-dot {
  background: var(--accent-blue);
}

.direction-legend .receiving-dot {
  background: var(--ink);
}

/* =========================================================================
   E2: Outlier explorer
   ========================================================================= */

.outlier-section {
  padding: 16px;
}

.outlier-header {
  margin-bottom: 12px;
  flex-wrap: wrap;
  gap: 10px;
}

.outlier-threshold-control {
  display: grid;
  gap: 4px;
  min-width: 130px;
}

.outlier-threshold-control label {
  font-size: 10.5px;
  color: var(--ink-soft);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.outlier-threshold-control select {
  height: 32px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper);
  color: var(--ink);
  font-weight: 700;
  font-size: 12.5px;
  padding: 0 9px;
}

.outlier-summary {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 12px;
  padding: 10px 13px;
  border-radius: var(--radius-md);
  background: var(--stamp-soft);
  border: 1px solid #e8c2a8;
}

.outlier-summary strong {
  color: var(--stamp-dark);
  font-size: 20px;
  font-weight: 800;
}

.outlier-summary span {
  color: var(--stamp-dark);
  font-size: 12px;
  font-weight: 600;
}

.outlier-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.outlier-card {
  display: grid;
  grid-template-columns: 64px 1fr;
  gap: 9px;
  align-items: center;
  text-align: left;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper);
  padding: 8px;
  transition: 0.15s ease;
}

.outlier-card:hover {
  border-color: var(--stamp);
}

.outlier-card.selected {
  border-color: var(--stamp);
  background: var(--stamp-soft);
}

.outlier-card img {
  width: 64px;
  height: 50px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  background: var(--paper-raised);
}

.outlier-card-body {
  display: grid;
  gap: 3px;
  min-width: 0;
}

.outlier-card-top {
  display: flex;
  justify-content: space-between;
  gap: 6px;
  align-items: center;
}

.outlier-card-top strong {
  color: var(--ink);
  font-size: 11.5px;
  font-weight: 800;
}

.outlier-card-top span {
  color: var(--stamp-dark);
  background: var(--stamp-soft);
  border-radius: 999px;
  padding: 2px 6px;
  font-size: 9.5px;
  font-weight: 800;
  flex-shrink: 0;
}

.outlier-card p {
  margin: 0;
  color: var(--stamp-dark);
  font-size: 10.5px;
  font-weight: 700;
}

.outlier-card small {
  color: var(--ink-faint);
  font-size: 10px;
}

/* =========================================================================
   Postcards list (kept available, off by default in the dashboard layout)
   ========================================================================= */

.list-section {
  padding: 16px;
  max-height: 420px;
  overflow: auto;
}

.postcard-grid {
  margin-top: 12px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.postcard-card {
  display: grid;
  grid-template-columns: 64px 1fr;
  gap: 9px;
  text-align: left;
  align-items: center;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper);
  padding: 8px;
  transition: 0.15s ease;
}

.postcard-card:hover,
.postcard-card.selected {
  border-color: var(--stamp);
  background: var(--stamp-soft);
}

.postcard-card img {
  width: 64px;
  height: 50px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  background: var(--paper-raised);
}

.postcard-card h3 {
  margin: 0 0 3px;
  font-size: 12.5px;
  color: var(--ink);
  font-weight: 800;
}

.postcard-card p {
  margin: 0 0 3px;
  color: var(--ink-soft);
  font-size: 11px;
}

.postcard-card small {
  color: var(--ink-faint);
  font-size: 10.5px;
}

/* =========================================================================
   Detail panel (right column)
   ========================================================================= */

.online-dot {
  width: 9px;
  height: 9px;
  background: #2f9e44;
  border-radius: 50%;
  box-shadow: 0 0 0 3px #ddf2e1;
  margin-top: 3px;
  flex-shrink: 0;
}

.detail-empty {
  min-height: 280px;
  display: grid;
  place-items: center;
  padding: 20px;
  text-align: center;
  color: var(--ink-faint);
  font-size: 13px;
  line-height: 1.5;
}

.detail-image {
  width: 100%;
  max-height: 200px;
  object-fit: contain;
  border-radius: var(--radius-md);
  background: var(--paper);
  border: 1px solid var(--line);
  margin-bottom: 12px;
}

.selected-route-note {
  display: inline-block;
  margin: 0 0 10px;
  padding: 5px 10px;
  border-radius: 999px;
  background: var(--accent-blue-soft);
  color: var(--accent-blue);
  font-size: 11px;
  font-weight: 800;
}

.detail-table {
  display: grid;
  gap: 10px;
}

.detail-table div {
  display: grid;
  grid-template-columns: 100px 1fr;
  gap: 8px;
  align-items: start;
}

.detail-table span {
  color: var(--ink-faint);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  padding-top: 1px;
}

.detail-table strong {
  color: var(--ink);
  font-size: 12.5px;
  font-weight: 700;
  line-height: 1.35;
}

.topic-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 13px;
}

.topic-tags span {
  padding: 5px 10px;
  border-radius: 999px;
  background: var(--stamp-soft);
  color: var(--stamp-dark);
  font-size: 11.5px;
  font-weight: 800;
}

.detail-actions {
  margin-top: 16px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.detail-actions button {
  height: 36px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--line);
  background: var(--paper);
  color: var(--ink);
  font-weight: 800;
  font-size: 12.5px;
}

.detail-actions button:hover {
  border-color: var(--ink);
}

.detail-actions button:first-child {
  border-color: #e8c2a8;
  color: var(--stamp-dark);
  background: var(--stamp-soft);
}

.detail-actions button:first-child:hover {
  border-color: var(--stamp);
}

/* =========================================================================
   Empty states
   ========================================================================= */

.empty-state {
  display: grid;
  place-items: center;
  text-align: center;
  padding: 26px;
  border: 1px dashed var(--line);
  border-radius: var(--radius-md);
  color: var(--ink-faint);
  background: var(--paper);
  font-size: 13px;
}

.empty-state h3 {
  margin: 0 0 6px;
  color: var(--ink);
  font-size: 14px;
  font-weight: 800;
}

.empty-state p {
  margin: 0;
  font-size: 12.5px;
}

.map-empty {
  height: 100%;
}

/* =========================================================================
   Responsive
   ========================================================================= */

@media (max-width: 1400px) {
  .dashboard-layout {
    grid-template-columns: 250px minmax(0, 1fr) 280px;
  }

  .outlier-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cluster-canvas {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 1180px) {
  .dashboard-layout {
    grid-template-columns: 230px minmax(0, 1fr);
  }

  .detail-panel {
    grid-column: 1 / -1;
    position: static;
    max-height: none;
  }
}

@media (max-width: 980px) {
  .topbar {
    grid-template-columns: 1fr;
  }

  .top-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .dashboard-layout {
    grid-template-columns: 1fr;
  }

  .filters-panel,
  .detail-panel {
    position: static;
    max-height: none;
  }

  .cluster-canvas {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-height: none;
  }

  .outlier-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .postcard-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .cluster-members-bar {
    grid-template-columns: 1fr;
  }

  .map-overlay-legend {
    display: none;
  }
}

@media (max-width: 640px) {
  .app-shell {
    padding: 14px;
  }

  .brand h1 {
    font-size: 22px;
  }

  .top-stats {
    grid-template-columns: 1fr;
  }

  .cluster-canvas {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .outlier-grid {
    grid-template-columns: 1fr;
  }

  .postcard-grid {
    grid-template-columns: 1fr;
  }
}

/* === E4 PARENT TOPIC FILTER FIX STYLE START === */

.topic-tree-group-action {
  display: block;
  width: calc(100% - 20px);
  height: 28px;
  margin: 0 10px 9px;
  border: 1px solid var(--stamp);
  border-radius: 999px;
  background: var(--stamp-soft);
  color: var(--stamp-dark);
  font-size: 10.5px;
  font-weight: 850;
}

.topic-tree-group-action:hover {
  background: var(--stamp);
  color: white;
}

.topic-tree-group.active .topic-tree-group-action {
  background: var(--stamp);
  color: white;
}

.active-topic-group-note {
  margin-top: 12px;
  padding: 11px;
  border-radius: var(--radius-sm);
  background: var(--accent-blue-soft);
  border: 1px solid #c7d9ea;
}

.active-topic-group-note p {
  margin: 0 0 9px;
  font-size: 12px;
  color: var(--accent-blue);
  line-height: 1.4;
}

.active-topic-group-note strong {
  color: var(--ink);
}

.active-topic-group-note button {
  width: 100%;
  height: 32px;
  border: none;
  border-radius: var(--radius-sm);
  background: var(--accent-blue);
  color: white;
  font-size: 11px;
  font-weight: 850;
}

/* === E4 PARENT TOPIC FILTER FIX STYLE END === */

/* === CURRENT VERSION CLEANUP START === */

/* 1) Remove map cluster legend, keep only Origin / Receiving */

.map-overlay-legend {
  width: auto !important;
  min-width: 160px !important;
  max-width: 180px !important;
  padding: 8px 12px !important;
  border-radius: 999px !important;
  background: rgba(255, 255, 255, 0.94) !important;
  backdrop-filter: blur(8px) !important;
}

/* Hide "Filter by cluster" title and cluster color list */
.map-overlay-legend > strong,
.map-overlay-legend > div:not(.direction-legend) {
  display: none !important;
}

/* Keep only Origin / Receiving */
.map-overlay-legend .direction-legend {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 14px !important;
  margin: 0 !important;
  padding: 0 !important;
  border-top: none !important;
}

.map-overlay-legend .direction-legend span {
  display: inline-flex !important;
  align-items: center !important;
  gap: 6px !important;
  font-size: 11.5px !important;
  font-weight: 800 !important;
  color: var(--ink-soft) !important;
  white-space: nowrap !important;
}

.map-overlay-legend .origin-dot,
.map-overlay-legend .receiving-dot {
  width: 9px !important;
  height: 9px !important;
  border-radius: 50% !important;
  display: inline-block !important;
}

.map-overlay-legend .origin-dot {
  background: var(--accent-blue) !important;
}

.map-overlay-legend .receiving-dot {
  background: var(--ink) !important;
}


/* 2) Remove Postcards List section */

.list-section {
  display: none !important;
}


/* 3) Make Image Cluster Map smaller */

.cluster-section {
  padding: 12px !important;
}

.cluster-section .section-header {
  margin-bottom: 6px !important;
}

.cluster-section .section-header h2 {
  font-size: 16px !important;
  line-height: 1.1 !important;
}

.cluster-section .section-header p {
  font-size: 11px !important;
  margin-top: 2px !important;
}

/* Compact cluster grid */

.cluster-canvas {
  margin-top: 8px !important;
  grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
  gap: 8px !important;
  max-height: 245px !important;
  overflow: auto !important;
  padding: 4px !important;
}

.topic-bubble,
.cluster-zoom-1 .topic-bubble,
.cluster-zoom-2 .topic-bubble,
.cluster-zoom-3 .topic-bubble {
  height: 112px !important;
  min-height: 112px !important;
  border-radius: 14px !important;
}

/* Smaller title inside cluster cards */

.topic-title {
  padding: 6px 8px !important;
  gap: 5px !important;
}

.topic-title h3 {
  font-size: 10.5px !important;
  line-height: 1.18 !important;
  font-weight: 850 !important;
  -webkit-line-clamp: 2 !important;
}

.topic-title p {
  font-size: 9.5px !important;
}

/* Smaller image preview inside cluster cards */

.topic-image-cloud img:first-child {
  height: 100% !important;
  width: 100% !important;
}

.topic-image-cloud img:nth-child(2),
.topic-image-cloud img:nth-child(3) {
  width: 28% !important;
  height: 38% !important;
  bottom: -5px !important;
}

/* Selected cluster strip smaller */

.cluster-members-bar {
  margin-top: 8px !important;
  padding: 7px 10px !important;
  min-height: 40px !important;
}

.cluster-members-bar h3 {
  font-size: 12px !important;
}

.cluster-members-bar p {
  font-size: 10px !important;
}

.cluster-member-strip button {
  width: 38px !important;
  height: 28px !important;
}

.cluster-member-actions button {
  width: 25px !important;
  height: 25px !important;
}

@media (max-width: 1400px) {
  .cluster-canvas {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    max-height: 260px !important;
  }

  .topic-bubble,
  .cluster-zoom-1 .topic-bubble,
  .cluster-zoom-2 .topic-bubble,
  .cluster-zoom-3 .topic-bubble {
    height: 106px !important;
    min-height: 106px !important;
  }
}

/* === CURRENT VERSION CLEANUP END === */
