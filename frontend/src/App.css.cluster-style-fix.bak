/* =========================================================================
   Postcard Explorer — Design Tokens
   A clean analytics-dashboard palette: cool paper background, navy ink,
   and four data-role accents (blue / green / purple / orange) used for
   stat icons and action buttons. Cluster colors come from the backend
   and are treated as data encoding, applied via CSS variables.
   ========================================================================= */

:root {
  --paper: #f1f4f9;
  --paper-raised: #ffffff;
  --ink: #1c2434;
  --ink-soft: #5e6b80;
  --ink-faint: #93a0b4;
  --line: #e5e9f1;
  --line-soft: #edf0f6;

  --blue: #2f6fed;
  --blue-soft: #e9f0fe;
  --green: #1aa251;
  --green-soft: #e6f8ec;
  --purple: #7c4fe0;
  --purple-soft: #efe8fc;
  --orange: #ef7d33;
  --orange-soft: #fdebdc;

  --accent: var(--blue);
  --accent-soft: var(--blue-soft);

  --shadow-sm: 0 1px 2px rgba(28, 36, 52, 0.05);
  --shadow-md: 0 8px 22px rgba(28, 36, 52, 0.08);
  --shadow-lg: 0 18px 44px rgba(28, 36, 52, 0.14);

  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 18px;
  --radius-pill: 999px;

  --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font);
  -webkit-font-smoothing: antialiased;
}

button,
input,
select {
  font-family: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

button:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 2px solid var(--blue);
  outline-offset: 2px;
}

/* =========================================================================
   Shell
   ========================================================================= */

.app-shell {
  width: 100%;
  min-height: 100vh;
  padding: 18px 22px 32px;
}

/* =========================================================================
   Top bar
   ========================================================================= */

.topbar {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 18px;
  align-items: center;
  margin-bottom: 18px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 14px;
}

.brand-icon {
  width: 50px;
  height: 50px;
  border-radius: var(--radius-md);
  display: grid;
  place-items: center;
  background: var(--blue-soft);
  color: var(--blue);
  font-size: 20px;
  flex-shrink: 0;
}

.brand h1 {
  margin: 0;
  font-size: 24px;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.3px;
  color: var(--ink);
}

.brand p {
  margin: 4px 0 0;
  color: var(--ink-soft);
  font-weight: 600;
  font-size: 12.5px;
  letter-spacing: 0.01em;
}

.top-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.top-stat {
  display: flex;
  gap: 11px;
  align-items: flex-start;
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  padding: 11px 14px;
  box-shadow: var(--shadow-sm);
  min-width: 0;
}

.stat-icon {
  width: 34px;
  height: 34px;
  border-radius: var(--radius-sm);
  display: grid;
  place-items: center;
  font-size: 15px;
  font-weight: 900;
  flex-shrink: 0;
}

.stat-icon.blue {
  background: var(--blue-soft);
  color: var(--blue);
}

.stat-icon.green {
  background: var(--green-soft);
  color: var(--green);
}

.stat-icon.purple {
  background: var(--purple-soft);
  color: var(--purple);
}

.stat-icon.orange {
  background: var(--orange-soft);
  color: var(--orange);
}

.top-stat p {
  margin: 0 0 2px;
  color: var(--ink-soft);
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.top-stat strong {
  display: block;
  font-size: 17px;
  font-weight: 800;
  color: var(--ink);
  white-space: nowrap;
}

.top-stat small {
  display: block;
  margin-top: 1px;
  color: var(--ink-faint);
  font-size: 10.5px;
  font-weight: 600;
  white-space: nowrap;
}

.topbar-icon-actions {
  display: flex;
  gap: 8px;
  align-self: start;
}

.icon-action-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1px solid var(--line);
  background: var(--paper-raised);
  color: var(--ink-faint);
  font-size: 13px;
  font-weight: 800;
  display: grid;
  place-items: center;
}

.icon-action-btn:hover {
  border-color: var(--blue);
  color: var(--blue);
}

/* =========================================================================
   Main layout — three real columns
   ========================================================================= */

.dashboard-layout {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr) 320px;
  gap: 16px;
  align-items: start;
}

.workspace {
  display: grid;
  gap: 16px;
  min-width: 0;
}

.card,
.filters-panel,
.detail-panel {
  background: var(--paper-raised);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.card {
  padding: 16px;
}

.filters-panel,
.detail-panel {
  position: sticky;
  top: 18px;
  max-height: calc(100vh - 36px);
  overflow: auto;
  padding: 16px;
}

.filters-panel::-webkit-scrollbar,
.detail-panel::-webkit-scrollbar,
.list-section::-webkit-scrollbar {
  width: 6px;
}

.filters-panel::-webkit-scrollbar-thumb,
.detail-panel::-webkit-scrollbar-thumb,
.list-section::-webkit-scrollbar-thumb {
  background: var(--line);
  border-radius: 4px;
}

.panel-title,
.section-header,
.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}

.panel-title h2,
.section-header h2,
.detail-header h2 {
  margin: 0;
  font-size: 15px;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: -0.1px;
}

.section-header p {
  margin: 3px 0 0;
  color: var(--ink-soft);
  font-size: 12px;
  font-weight: 600;
}

.collapse-toggle {
  width: 22px;
  height: 22px;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: var(--paper);
  color: var(--ink-soft);
  font-size: 11px;
  display: grid;
  place-items: center;
}

.filters-panel.collapsed {
  max-height: none;
}

/* =========================================================================
   Filters panel
   ========================================================================= */

.filters-panel label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16px 0 7px;
  color: var(--ink-soft);
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.filters-panel label:first-of-type {
  margin-top: 14px;
}

.label-sub {
  color: var(--ink-faint);
  font-weight: 700;
  text-transform: none;
  letter-spacing: 0;
  font-size: 10.5px;
}

.filters-panel input,
.filters-panel select {
  width: 100%;
  height: 36px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper);
  color: var(--ink);
  padding: 0 11px;
  font-size: 13px;
  outline: none;
  transition: border-color 0.15s ease;
}

.filters-panel input:focus,
.filters-panel select:focus {
  border-color: var(--blue);
  background: var(--paper-raised);
}

.search-box {
  position: relative;
}

.search-box input {
  padding-right: 34px;
}

.search-box span {
  position: absolute;
  right: 11px;
  top: 9px;
  color: var(--ink-faint);
  font-size: 14px;
}

.date-row,
.distance-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.range-decoration {
  height: 4px;
  margin-top: 10px;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, var(--blue-soft), var(--blue) 35%, var(--blue) 65%, var(--blue-soft));
  opacity: 0.55;
}

.distance-slider {
  width: 100%;
  margin-top: 10px;
  height: 18px;
  -webkit-appearance: none;
  appearance: none;
  background: transparent;
  padding: 0 !important;
}

.distance-slider::-webkit-slider-runnable-track {
  height: 4px;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, var(--blue) 0%, var(--blue-soft) 100%);
}

.distance-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  margin-top: -6px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--paper-raised);
  border: 3px solid var(--blue);
  box-shadow: var(--shadow-sm);
}

.distance-slider::-moz-range-track {
  height: 4px;
  border-radius: var(--radius-pill);
  background: linear-gradient(90deg, var(--blue) 0%, var(--blue-soft) 100%);
}

.distance-slider::-moz-range-thumb {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--paper-raised);
  border: 3px solid var(--blue);
}

/* E1: global search helper chips */

.e1-search-help {
  margin-top: 9px;
  padding: 10px;
  border-radius: var(--radius-sm);
  background: var(--paper);
  border: 1px solid var(--line-soft);
}

.e1-search-help p {
  margin: 0 0 8px;
  color: var(--ink-soft);
  font-size: 11px;
  line-height: 1.4;
  font-weight: 600;
}

.e1-search-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.e1-search-chips button {
  border: 1px solid var(--line);
  border-radius: var(--radius-pill);
  background: var(--paper-raised);
  color: var(--ink-soft);
  padding: 5px 9px;
  font-size: 11px;
  font-weight: 700;
  transition: 0.15s ease;
}

.e1-search-chips button:hover {
  background: var(--blue-soft);
  color: var(--blue);
  border-color: var(--blue);
}

.active-search-note {
  margin-top: 12px;
  padding: 11px;
  border-radius: var(--radius-sm);
  background: var(--blue-soft);
  border: 1px solid #c9dbfb;
}

.active-search-note span {
  display: block;
  color: var(--blue);
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  margin-bottom: 3px;
}

.active-search-note strong {
  display: block;
  color: var(--ink);
  font-size: 13px;
  margin-bottom: 9px;
  word-break: break-word;
}

.active-search-note button {
  width: 100%;
  height: 30px;
  border: none;
  border-radius: var(--radius-sm);
  background: var(--blue);
  color: white;
  font-size: 11px;
  font-weight: 800;
}

/* Country checklist (M1 filters) */

.country-checklist {
  display: grid;
  gap: 3px;
  max-height: 168px;
  overflow: auto;
  padding-right: 2px;
}

.country-checklist button {
  display: grid;
  grid-template-columns: 16px 1fr;
  gap: 9px;
  align-items: center;
  min-height: 28px;
  border: none;
  background: transparent;
  border-radius: var(--radius-sm);
  padding: 4px 6px;
  color: var(--ink-soft);
  text-align: left;
  font-size: 12.5px;
  font-weight: 600;
}

.country-checklist button:hover {
  background: var(--line-soft);
}

.country-checklist button.active {
  background: var(--blue-soft);
  color: var(--blue);
  font-weight: 700;
}

.country-checklist .check-box {
  width: 14px;
  height: 14px;
  border-radius: 4px;
  border: 1.5px solid var(--line);
  background: var(--paper-raised);
  display: block;
}

.country-checklist button.active .check-box {
  border-color: var(--blue);
  background: var(--blue);
  position: relative;
}

.country-checklist button.active .check-box::after {
  content: "";
  position: absolute;
  left: 4px;
  top: 1px;
  width: 4px;
  height: 7px;
  border: solid white;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

.country-overflow-select {
  margin-top: 6px;
}

/* Topic / cluster filter list */

.topic-filter-list {
  display: grid;
  gap: 4px;
  max-height: 200px;
  overflow: auto;
  padding-right: 2px;
}

.topic-filter-list button {
  display: grid;
  grid-template-columns: 16px 1fr auto;
  gap: 9px;
  align-items: center;
  min-height: 30px;
  border: none;
  background: transparent;
  border-radius: var(--radius-sm);
  padding: 5px 7px;
  color: var(--ink-soft);
  text-align: left;
  font-size: 12px;
  font-weight: 600;
}

.topic-filter-list button:hover {
  background: var(--line-soft);
}

.topic-filter-list button.active {
  background: var(--paper);
  color: var(--ink);
}

.topic-filter-list strong {
  color: var(--ink-faint);
  font-size: 11px;
  font-weight: 800;
}

.topic-filter-list .check-box {
  width: 15px;
  height: 15px;
  border-radius: 4px;
  border: 1.5px solid var(--line);
  display: grid;
  place-items: center;
}

.check-box-fill {
  width: 8px;
  height: 8px;
  border-radius: 2px;
}

.topic-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
  box-shadow: 0 0 0 2px var(--paper-raised);
}

.active-cluster-note {
  margin-top: 12px;
  padding: 11px;
  border-radius: var(--radius-sm);
  background: var(--orange-soft);
  border: 1px solid #f3cfa9;
}

.active-cluster-note p {
  margin: 0 0 9px;
  font-size: 12px;
  color: #9a4f17;
  line-height: 1.4;
}

.active-cluster-note button,
.clear-button {
  width: 100%;
  height: 34px;
  border: none;
  border-radius: var(--radius-sm);
  color: white;
  font-weight: 800;
  font-size: 12px;
}

.active-cluster-note button {
  background: var(--orange);
}

.clear-button {
  margin-top: 16px;
  background: var(--ink);
}

/* Cluster color legend */

.cluster-color-legend {
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}

.legend-label {
  display: block;
  margin-bottom: 8px;
  color: var(--ink-soft);
  font-size: 11px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.legend-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px 10px;
}

.legend-grid span {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--ink-soft);
  font-size: 11px;
  font-weight: 600;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.legend-grid i {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  display: inline-block;
  flex-shrink: 0;
}

/* Result count */

.result-card {
  margin-top: 16px;
  padding: 14px;
  border-radius: var(--radius-md);
  background: var(--ink);
  text-align: left;
}

.result-card span {
  display: block;
  color: rgba(255, 255, 255, 0.6);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.result-card strong {
  display: block;
  margin-top: 4px;
  font-size: 26px;
  font-weight: 800;
  color: white;
}

.result-card p {
  margin: 2px 0 0;
  color: rgba(255, 255, 255, 0.55);
  font-size: 12px;
}

/* E4: topic hierarchy tree */

.topic-hierarchy-card {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}

.topic-hierarchy-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
}

.topic-hierarchy-head span {
  display: inline-block;
  margin-bottom: 3px;
  color: var(--blue);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.08em;
}

.topic-hierarchy-head h3 {
  margin: 0;
  color: var(--ink);
  font-size: 13px;
  font-weight: 800;
}

.topic-hierarchy-head button {
  height: 26px;
  padding: 0 10px;
  border: 1px solid var(--line);
  border-radius: var(--radius-pill);
  background: var(--paper);
  color: var(--ink-soft);
  font-size: 10.5px;
  font-weight: 800;
}

.topic-hierarchy-head button:hover {
  background: var(--ink);
  color: white;
  border-color: var(--ink);
}

.topic-hierarchy-intro {
  margin: 0 0 10px;
  color: var(--ink-faint);
  font-size: 11px;
  line-height: 1.4;
  font-weight: 600;
}

.topic-tree {
  display: grid;
  gap: 6px;
}

.topic-tree-group {
  border: 1px solid var(--line-soft);
  border-radius: 10px;
  background: var(--paper);
  overflow: hidden;
}

.topic-tree-group.active {
  border-color: var(--blue);
  background: var(--blue-soft);
}

.topic-tree-group summary {
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  padding: 9px 10px;
}

.topic-tree-group summary::-webkit-details-marker {
  display: none;
}

.topic-tree-group summary span {
  color: var(--ink);
  font-size: 11.5px;
  font-weight: 800;
}

.topic-tree-group summary strong {
  color: var(--blue);
  font-size: 11px;
  font-weight: 800;
}

.topic-tree-group small {
  display: block;
  padding: 0 10px 8px;
  color: var(--ink-faint);
  font-size: 10px;
  line-height: 1.4;
  font-weight: 600;
}

.topic-tree-children {
  display: grid;
  gap: 5px;
  padding: 0 8px 9px;
}

.topic-tree-leaf {
  display: grid;
  grid-template-columns: 8px 1fr auto;
  align-items: center;
  gap: 7px;
  width: 100%;
  text-align: left;
  border: 1px solid var(--line-soft);
  border-radius: 8px;
  background: var(--paper-raised);
  padding: 7px 8px;
  transition: 0.15s ease;
}

.topic-tree-leaf:hover {
  border-color: var(--blue);
}

.topic-tree-leaf.selected {
  border-color: var(--blue);
  background: var(--blue-soft);
}

.topic-tree-color {
  width: 7px;
  height: 7px;
  border-radius: 999px;
}

.topic-tree-name {
  min-width: 0;
  color: var(--ink-soft);
  font-size: 10.5px;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.topic-tree-leaf strong {
  color: var(--ink);
  font-size: 10.5px;
  font-weight: 800;
}

.topic-tree-group-action {
  display: block;
  width: calc(100% - 20px);
  height: 28px;
  margin: 0 10px 9px;
  border: 1px solid var(--blue);
  border-radius: var(--radius-pill);
  background: var(--blue-soft);
  color: var(--blue);
  font-size: 10.5px;
  font-weight: 850;
}

.topic-tree-group-action:hover {
  background: var(--blue);
  color: white;
}

.topic-tree-group.active .topic-tree-group-action {
  background: var(--blue);
  color: white;
}

.active-topic-group-note {
  margin-top: 12px;
  padding: 11px;
  border-radius: var(--radius-sm);
  background: var(--blue-soft);
  border: 1px solid #c9dbfb;
}

.active-topic-group-note p {
  margin: 0 0 9px;
  font-size: 12px;
  color: var(--blue);
  line-height: 1.4;
}

.active-topic-group-note strong {
  color: var(--ink);
}

.active-topic-group-note button {
  width: 100%;
  height: 32px;
  border: none;
  border-radius: var(--radius-sm);
  background: var(--blue);
  color: white;
  font-size: 11px;
  font-weight: 850;
}

/* =========================================================================
   Cluster section (M2) — organic "blob" scatter view + grid fallback,
   plus E3 semantic zoom toolbar
   ========================================================================= */

.cluster-section {
  padding: 16px;
}

.cluster-section.expanded .cluster-blob-field,
.cluster-section.expanded .cluster-canvas {
  max-height: 680px;
}

.view-mode-toggle {
  display: flex;
  gap: 4px;
  flex-shrink: 0;
  height: 30px;
}

.view-mode-toggle button {
  width: 32px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper);
  color: var(--ink-soft);
  font-size: 13px;
}

.view-mode-toggle button.active {
  background: var(--ink);
  color: white;
  border-color: var(--ink);
}

.cluster-canvas-wrap {
  position: relative;
  margin-top: 12px;
}

.cluster-map-toolbar {
  position: absolute;
  right: 8px;
  top: 8px;
  display: grid;
  gap: 5px;
  z-index: 5;
}

.cluster-map-toolbar button {
  width: 28px;
  height: 28px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper-raised);
  color: var(--ink-soft);
  font-size: 14px;
  font-weight: 800;
  box-shadow: var(--shadow-sm);
}

.cluster-map-toolbar button:hover {
  border-color: var(--blue);
  color: var(--blue);
}

.cluster-zoom-caption {
  position: absolute;
  right: 8px;
  top: 106px;
  font-size: 10px;
  font-weight: 700;
  color: var(--ink-faint);
  background: rgba(255, 255, 255, 0.85);
  padding: 2px 7px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--line);
}

/* --- Scatter / blob field --- */

.cluster-blob-field {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  grid-auto-flow: dense;
  gap: 10px;
  max-height: 460px;
  overflow: auto;
  padding: 4px 60px 4px 4px;
}

.topic-blob {
  position: relative;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--paper-raised);
  padding: 12px 10px 14px;
  min-height: 200px;
  display: flex;
  flex-direction: column;
  text-align: left;
  transition: 0.18s ease;
  overflow: hidden;
}

.topic-blob.blob-large {
  grid-column: span 2;
  min-height: 250px;
}

.topic-blob:hover {
  border-color: var(--cluster-color, var(--ink-faint));
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.topic-blob.selected {
  border-color: var(--cluster-color, var(--blue));
  border-width: 2px;
  box-shadow: var(--shadow-md);
}

.topic-blob-label {
  display: flex;
  align-items: baseline;
  gap: 7px;
  z-index: 2;
}

.topic-blob-label .topic-dot {
  width: 9px;
  height: 9px;
}

.topic-blob-label h3 {
  margin: 0;
  font-size: 12.5px;
  font-weight: 800;
  color: var(--ink);
}

.topic-blob-label p {
  margin: 0;
  color: var(--ink-faint);
  font-size: 10.5px;
  font-weight: 700;
}

.topic-blob-shape {
  position: relative;
  flex: 1;
  margin-top: 4px;
  border-radius: var(--blob-radius, 50%);
  background: radial-gradient(
    circle at 50% 45%,
    var(--blob-bg, rgba(100, 116, 139, 0.16)) 0%,
    var(--blob-bg-soft, rgba(100, 116, 139, 0.05)) 55%,
    transparent 78%
  );
}

.topic-blob-shape img {
  position: absolute;
  width: 24%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 6px;
  border: 2.5px solid var(--paper-raised);
  box-shadow: 0 4px 10px rgba(28, 36, 52, 0.18);
  background: var(--paper);
  transition: transform 0.15s ease;
}

.topic-blob-shape img.hero {
  width: 36%;
}

.topic-blob:hover .topic-blob-shape img {
  filter: saturate(1.05);
}

/* --- Grid fallback view --- */

.cluster-canvas {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 11px;
  max-height: 420px;
  overflow: auto;
  padding: 4px 60px 4px 4px;
}

.topic-bubble {
  position: relative;
  height: 168px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper-raised);
  padding: 0;
  text-align: left;
  transition: 0.18s ease;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.topic-bubble:hover {
  border-color: var(--cluster-color, var(--ink-faint));
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.topic-bubble.selected {
  border-color: var(--cluster-color, var(--blue));
  border-width: 2px;
  box-shadow: var(--shadow-md);
}

.topic-image-cloud {
  position: relative;
  flex: 1;
  min-height: 0;
  background: var(--paper);
  overflow: visible;
  padding: 0;
}

.topic-image-cloud img {
  position: absolute;
  border-radius: 5px;
  border: 2px solid var(--paper-raised);
  box-shadow: 0 3px 8px rgba(28, 36, 52, 0.18);
  object-fit: cover;
  background: var(--paper);
}

.topic-image-cloud img:first-child {
  position: static;
  width: 100%;
  height: 100%;
  border-radius: 0;
  border: none;
  box-shadow: none;
}

.topic-image-cloud img:nth-child(2) {
  width: 34%;
  height: 46%;
  bottom: -8px;
  left: -6px;
  transform: rotate(-9deg);
}

.topic-image-cloud img:nth-child(3) {
  width: 34%;
  height: 46%;
  bottom: -8px;
  right: -6px;
  transform: rotate(8deg);
}

.topic-image-cloud img:nth-child(n + 4) {
  display: none;
}

.topic-title {
  display: grid;
  grid-template-columns: 8px 1fr;
  align-items: start;
  gap: 7px;
  padding: 8px 10px;
  text-align: left;
  background: var(--paper-raised);
  border-top: 1px solid var(--line-soft);
}

.topic-title .topic-dot {
  width: 8px;
  height: 8px;
  margin-top: 3px;
}

.topic-title h3 {
  margin: 0;
  font-size: 11px;
  line-height: 1.25;
  font-weight: 800;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.topic-title p {
  margin: 2px 0 0;
  color: var(--ink-soft);
  font-size: 10px;
  font-weight: 700;
}

/* Semantic zoom levels (E3) */

.cluster-zoom-1.cluster-blob-field {
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
}

.cluster-zoom-3.cluster-blob-field {
  grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
}

.cluster-zoom-1 .topic-bubble {
  height: 168px;
}

.cluster-zoom-2 .topic-bubble {
  height: 196px;
}

.cluster-zoom-3 .topic-bubble {
  height: 230px;
}

.cluster-zoom-3 .topic-image-cloud img:nth-child(2),
.cluster-zoom-3 .topic-image-cloud img:nth-child(3) {
  width: 30%;
  height: 38%;
}

.cluster-zoom-3 .topic-image-cloud img:nth-child(4) {
  display: block;
  width: 26%;
  height: 32%;
  top: 6%;
  right: 4%;
  transform: rotate(6deg);
}

/* Selected cluster filmstrip */

.cluster-members-bar {
  margin-top: 12px;
  display: grid;
  grid-template-columns: 200px auto 1fr;
  gap: 10px;
  align-items: center;
  padding: 10px 12px;
  border-radius: var(--radius-md);
  background: var(--paper);
  border: 1px solid var(--line-soft);
}

.cluster-members-bar h3 {
  margin: 0;
  font-size: 12.5px;
  font-weight: 800;
  color: var(--ink);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cluster-members-bar p {
  margin: 2px 0 0;
  color: var(--ink-soft);
  font-size: 10.5px;
  font-weight: 600;
}

.cluster-member-actions {
  display: flex;
  gap: 5px;
}

.cluster-member-actions button {
  width: 27px;
  height: 27px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper-raised);
  color: var(--ink);
  font-size: 16px;
  line-height: 1;
}

.cluster-member-actions button:hover:not(:disabled) {
  border-color: var(--blue);
  color: var(--blue);
}

.cluster-member-strip {
  display: flex;
  gap: 6px;
  overflow: auto;
  padding-bottom: 2px;
}

.cluster-member-strip button {
  flex: 0 0 auto;
  width: 44px;
  height: 34px;
  border: 2px solid transparent;
  border-radius: 7px;
  background: var(--paper-raised);
  padding: 0;
  overflow: hidden;
}

.cluster-member-strip button.selected {
  border-color: var(--blue);
}

.cluster-member-strip img {
  width: 100%;
  height: 100%;
  border-radius: 5px;
  object-fit: cover;
}

/* =========================================================================
   Journey map (M3)
   ========================================================================= */

.journey-section {
  padding: 16px;
}

.map-title-row {
  margin-bottom: 10px;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

.map-semantic-zoom-note {
  display: grid;
  gap: 2px;
  min-width: 120px;
  padding: 7px 11px;
  border-radius: var(--radius-sm);
  background: var(--paper);
  border: 1px solid var(--line-soft);
}

.map-semantic-zoom-note span {
  color: var(--ink-faint);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.map-semantic-zoom-note strong {
  color: var(--ink);
  font-size: 12.5px;
  font-weight: 800;
}

.map-semantic-zoom-note small {
  color: var(--blue);
  font-size: 10px;
  font-weight: 700;
}

.route-limit-control {
  display: grid;
  gap: 4px;
  min-width: 120px;
}

.route-limit-control label {
  font-size: 10.5px;
  font-weight: 800;
  color: var(--ink-soft);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.route-limit-control select {
  height: 34px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper);
  color: var(--ink);
  font-weight: 700;
  font-size: 12.5px;
  padding: 0 9px;
}

.journey-map-wrap {
  position: relative;
  height: 460px;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 1px solid var(--line);
  background: #e6edf5;
}

.route-map,
.journey-map-wrap .leaflet-container {
  width: 100% !important;
  height: 460px !important;
  min-height: 460px;
  display: block;
}

.leaflet-container {
  font-family: var(--font);
  background: #eef3f9;
}

.leaflet-tile {
  filter: saturate(0.9) contrast(1.02);
}

.leaflet-control-zoom {
  border: none !important;
  border-radius: var(--radius-sm) !important;
  overflow: hidden;
  box-shadow: var(--shadow-md) !important;
}

.leaflet-control-zoom a {
  border: none !important;
  color: var(--ink) !important;
}

.leaflet-popup-content-wrapper {
  border-radius: var(--radius-md) !important;
  box-shadow: var(--shadow-lg) !important;
}

.route-popup {
  width: 190px;
}

.route-popup img {
  width: 100%;
  max-height: 115px;
  object-fit: contain;
  background: var(--paper);
  border-radius: var(--radius-sm);
  margin-bottom: 8px;
}

.route-popup p {
  margin: 4px 0;
  font-size: 12px;
}

.map-overlay-legend {
  position: absolute;
  right: 12px;
  bottom: 12px;
  z-index: 450;
  width: 216px;
  background: rgba(255, 255, 255, 0.97);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 10px;
  box-shadow: var(--shadow-md);
}

.map-overlay-legend-head {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 8px;
}

.map-overlay-legend strong {
  display: block;
  font-size: 11.5px;
  color: var(--ink);
}

.toggle-switch {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--ink-soft);
  font-size: 10px;
  font-weight: 700;
  cursor: pointer;
}

.toggle-switch input {
  display: none;
}

.toggle-track {
  position: relative;
  width: 26px;
  height: 15px;
  border-radius: var(--radius-pill);
  background: var(--line);
  transition: background 0.15s ease;
  flex-shrink: 0;
}

.toggle-thumb {
  position: absolute;
  top: 2px;
  left: 2px;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: white;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease;
}

.toggle-switch input:checked + .toggle-track {
  background: var(--blue);
}

.toggle-switch input:checked + .toggle-track .toggle-thumb {
  transform: translateX(11px);
}

.map-overlay-legend > div:not(.map-overlay-legend-head):not(.direction-legend) {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

.map-overlay-legend > div:not(.map-overlay-legend-head):not(.direction-legend) button {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  border: none;
  background: transparent;
  color: var(--ink-soft);
  font-size: 10.5px;
  font-weight: 600;
  padding: 2px 0;
  text-align: left;
}

.map-overlay-legend
  > div:not(.map-overlay-legend-head):not(.direction-legend)
  button.active {
  color: var(--ink);
  font-weight: 800;
}

.map-overlay-legend i {
  width: 11px;
  height: 3px;
  display: inline-block;
  border-radius: 999px;
  flex-shrink: 0;
}

.direction-legend {
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid var(--line-soft);
}

.direction-legend span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--ink-soft);
  font-size: 10.5px;
}

.direction-legend .origin-dot,
.direction-legend .receiving-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
}

.direction-legend .origin-dot {
  background: var(--blue);
}

.direction-legend .receiving-dot {
  background: var(--ink);
}

/* =========================================================================
   E2: Outlier explorer
   ========================================================================= */

.outlier-section {
  padding: 16px;
}

.outlier-header {
  margin-bottom: 12px;
  flex-wrap: wrap;
  gap: 10px;
}

.outlier-threshold-control {
  display: grid;
  gap: 4px;
  min-width: 130px;
}

.outlier-threshold-control label {
  font-size: 10.5px;
  color: var(--ink-soft);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.outlier-threshold-control select {
  height: 32px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--paper);
  color: var(--ink);
  font-weight: 700;
  font-size: 12.5px;
  padding: 0 9px;
}

.outlier-summary {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-bottom: 12px;
  padding: 10px 13px;
  border-radius: var(--radius-md);
  background: var(--orange-soft);
  border: 1px solid #f3cfa9;
}

.outlier-summary strong {
  color: #9a4f17;
  font-size: 20px;
  font-weight: 800;
}

.outlier-summary span {
  color: #9a4f17;
  font-size: 12px;
  font-weight: 600;
}

.outlier-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.outlier-card {
  display: grid;
  grid-template-columns: 64px 1fr;
  gap: 9px;
  align-items: center;
  text-align: left;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper);
  padding: 8px;
  transition: 0.15s ease;
}

.outlier-card:hover {
  border-color: var(--orange);
}

.outlier-card.selected {
  border-color: var(--orange);
  background: var(--orange-soft);
}

.outlier-card img {
  width: 64px;
  height: 50px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  background: var(--paper-raised);
}

.outlier-card-body {
  display: grid;
  gap: 3px;
  min-width: 0;
}

.outlier-card-top {
  display: flex;
  justify-content: space-between;
  gap: 6px;
  align-items: center;
}

.outlier-card-top strong {
  color: var(--ink);
  font-size: 11.5px;
  font-weight: 800;
}

.outlier-card-top span {
  color: #9a4f17;
  background: var(--orange-soft);
  border-radius: 999px;
  padding: 2px 6px;
  font-size: 9.5px;
  font-weight: 800;
  flex-shrink: 0;
}

.outlier-card p {
  margin: 0;
  color: #9a4f17;
  font-size: 10.5px;
  font-weight: 700;
}

.outlier-card small {
  color: var(--ink-faint);
  font-size: 10px;
}

/* =========================================================================
   Postcards list (M1)
   ========================================================================= */

.list-section {
  padding: 16px;
  max-height: 420px;
  overflow: auto;
}

.postcard-grid {
  margin-top: 12px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.postcard-card {
  display: grid;
  grid-template-columns: 64px 1fr;
  gap: 9px;
  text-align: left;
  align-items: center;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--paper);
  padding: 8px;
  transition: 0.15s ease;
}

.postcard-card:hover,
.postcard-card.selected {
  border-color: var(--blue);
  background: var(--blue-soft);
}

.postcard-card img {
  width: 64px;
  height: 50px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  background: var(--paper-raised);
}

.postcard-card h3 {
  margin: 0 0 3px;
  font-size: 12.5px;
  color: var(--ink);
  font-weight: 800;
}

.postcard-card p {
  margin: 0 0 3px;
  color: var(--ink-soft);
  font-size: 11px;
}

.postcard-card small {
  color: var(--ink-faint);
  font-size: 10.5px;
}

/* =========================================================================
   Detail panel (right column) — "Selected Postcard"
   ========================================================================= */

.online-dot {
  width: 9px;
  height: 9px;
  background: var(--green);
  border-radius: 50%;
  box-shadow: 0 0 0 3px var(--green-soft);
  margin-top: 3px;
  flex-shrink: 0;
}

.detail-empty {
  min-height: 280px;
  display: grid;
  place-items: center;
  padding: 20px;
  text-align: center;
  color: var(--ink-faint);
  font-size: 13px;
  line-height: 1.5;
}

.detail-image {
  width: 100%;
  max-height: 200px;
  object-fit: contain;
  border-radius: var(--radius-md);
  background: var(--paper);
  border: 1px solid var(--line);
  margin-bottom: 10px;
}

.detail-carousel {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  margin-bottom: 12px;
}

.detail-carousel button {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 1px solid var(--line);
  background: var(--paper);
  color: var(--ink);
  font-size: 15px;
  line-height: 1;
}

.detail-carousel button:hover {
  border-color: var(--blue);
  color: var(--blue);
}

.detail-carousel span {
  color: var(--ink-soft);
  font-size: 12px;
  font-weight: 700;
}

.selected-route-note {
  display: inline-block;
  margin: 0 0 10px;
  padding: 5px 10px;
  border-radius: 999px;
  background: var(--blue-soft);
  color: var(--blue);
  font-size: 11px;
  font-weight: 800;
}

.detail-table {
  display: grid;
  gap: 10px;
}

.detail-table div {
  display: grid;
  grid-template-columns: 100px 1fr;
  gap: 8px;
  align-items: start;
}

.detail-table span {
  color: var(--ink-faint);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  padding-top: 1px;
}

.detail-table strong {
  color: var(--ink);
  font-size: 12.5px;
  font-weight: 700;
  line-height: 1.35;
}

.topic-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 13px;
}

.topic-tags span {
  padding: 5px 10px;
  border-radius: 999px;
  background: var(--purple-soft);
  color: var(--purple);
  font-size: 11.5px;
  font-weight: 800;
}

.detail-actions {
  margin-top: 16px;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8px;
}

.detail-actions button {
  height: 38px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--line);
  background: var(--paper);
  color: var(--ink);
  font-weight: 800;
  font-size: 11px;
  padding: 0 4px;
}

.action-highlight {
  border-color: #ddc9f8 !important;
  color: var(--purple) !important;
  background: var(--purple-soft) !important;
}

.action-highlight:hover:not(:disabled) {
  border-color: var(--purple) !important;
}

.action-route {
  border-color: #c9dbfb !important;
  color: var(--blue) !important;
  background: var(--blue-soft) !important;
}

.action-route:hover:not(:disabled) {
  border-color: var(--blue) !important;
}

.action-cluster {
  border-color: #f3cfa9 !important;
  color: var(--orange) !important;
  background: var(--orange-soft) !important;
}

.action-cluster:hover:not(:disabled) {
  border-color: var(--orange) !important;
}

.detail-clear {
  width: 100%;
  height: 32px;
  margin-top: 8px;
  border: none;
  border-radius: var(--radius-sm);
  background: transparent;
  color: var(--ink-faint);
  font-weight: 700;
  font-size: 11.5px;
}

.detail-clear:hover {
  color: var(--ink);
  text-decoration: underline;
}

/* =========================================================================
   Empty states
   ========================================================================= */

.empty-state {
  display: grid;
  place-items: center;
  text-align: center;
  padding: 26px;
  border: 1px dashed var(--line);
  border-radius: var(--radius-md);
  color: var(--ink-faint);
  background: var(--paper);
  font-size: 13px;
}

.empty-state h3 {
  margin: 0 0 6px;
  color: var(--ink);
  font-size: 14px;
  font-weight: 800;
}

.empty-state p {
  margin: 0;
  font-size: 12.5px;
}

.map-empty {
  height: 100%;
}

/* =========================================================================
   Responsive
   ========================================================================= */

@media (max-width: 1400px) {
  .dashboard-layout {
    grid-template-columns: 260px minmax(0, 1fr) 290px;
  }

  .outlier-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cluster-canvas {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .top-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .topbar {
    grid-template-columns: 1fr;
  }

  .topbar-icon-actions {
    justify-self: end;
  }
}

@media (max-width: 1180px) {
  .dashboard-layout {
    grid-template-columns: 230px minmax(0, 1fr);
  }

  .detail-panel {
    grid-column: 1 / -1;
    position: static;
    max-height: none;
  }
}

@media (max-width: 980px) {
  .top-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .dashboard-layout {
    grid-template-columns: 1fr;
  }

  .filters-panel,
  .detail-panel {
    position: static;
    max-height: none;
  }

  .cluster-canvas,
  .cluster-blob-field {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-height: none;
  }

  .topic-blob.blob-large {
    grid-column: span 2;
  }

  .outlier-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .postcard-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .cluster-members-bar {
    grid-template-columns: 1fr;
  }

  .map-overlay-legend {
    display: none;
  }
}

@media (max-width: 640px) {
  .app-shell {
    padding: 14px;
  }

  .brand h1 {
    font-size: 22px;
  }

  .top-stats {
    grid-template-columns: 1fr;
  }

  .cluster-canvas,
  .cluster-blob-field {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .topic-blob.blob-large {
    grid-column: span 2;
  }

  .outlier-grid {
    grid-template-columns: 1fr;
  }

  .postcard-grid {
    grid-template-columns: 1fr;
  }

  .detail-actions {
    grid-template-columns: 1fr;
  }
}

/* === CLEAN MAP LEGEND CLUSTERS LIST START === */

/* =========================================================
   CLEAN FINAL UI PATCH — CSS ONLY
   - remove map cluster legend
   - keep only Origin / Receiving
   - hide Postcards List
   - hide Cluster zoom / overview controls
   - make cluster photos smaller and names cleaner
   ========================================================= */


/* 1) Hide unnecessary sections / controls */

.list-section,
.route-limit-control,
.map-semantic-zoom-note,
.cluster-zoom-control,
.cluster-map-toolbar,
.cluster-zoom-caption,
.view-mode-toggle {
  display: none !important;
}


/* 2) Map legend: remove cluster legend, keep only Origin / Receiving */

.map-overlay-legend {
  right: 12px !important;
  bottom: 12px !important;
  width: auto !important;
  min-width: 170px !important;
  max-width: 190px !important;
  padding: 9px 12px !important;
  border-radius: 999px !important;
  background: rgba(255, 255, 255, 0.94) !important;
  backdrop-filter: blur(8px) !important;
  border: 1px solid rgba(229, 233, 241, 0.9) !important;
  box-shadow: 0 8px 22px rgba(28, 36, 52, 0.12) !important;
}

/* Hide map legend title, toggle, and cluster color buttons */
.map-overlay-legend-head,
.map-overlay-legend > strong,
.map-overlay-legend > div:not(.direction-legend) {
  display: none !important;
}

/* Force direction legend to remain visible */
.map-overlay-legend .direction-legend {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 14px !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
}

.direction-legend span {
  display: inline-flex !important;
  align-items: center !important;
  gap: 6px !important;
  color: var(--ink-soft) !important;
  font-size: 12px !important;
  font-weight: 800 !important;
  white-space: nowrap !important;
}

.direction-legend .origin-dot,
.direction-legend .receiving-dot {
  width: 10px !important;
  height: 10px !important;
  border-radius: 50% !important;
  display: inline-block !important;
  flex-shrink: 0 !important;
}

.direction-legend .origin-dot {
  background: var(--blue) !important;
}

.direction-legend .receiving-dot {
  background: var(--ink) !important;
}


/* 3) Clean map header */

.map-title-row {
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 10px !important;
  margin-bottom: 8px !important;
  min-height: 36px !important;
}

.map-title-row h2 {
  font-size: 17px !important;
  line-height: 1.1 !important;
}

.map-title-row p {
  font-size: 11.5px !important;
  margin-top: 3px !important;
}


/* 4) Compact cluster area */

.cluster-section {
  padding: 14px !important;
}

.cluster-canvas-wrap {
  margin-top: 10px !important;
}

.cluster-blob-field {
  grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)) !important;
  gap: 8px !important;
  max-height: 255px !important;
  overflow: auto !important;
  padding: 4px !important;
}

.topic-blob,
.topic-blob.blob-large {
  grid-column: span 1 !important;
  min-height: 118px !important;
  padding: 8px !important;
  border-radius: 14px !important;
}

.topic-blob-label {
  align-items: center !important;
  gap: 6px !important;
  min-width: 0 !important;
}

.topic-blob-label .topic-dot {
  width: 7px !important;
  height: 7px !important;
  flex-shrink: 0 !important;
}

.topic-blob-label h3 {
  max-width: 115px !important;
  margin: 0 !important;
  font-size: 9.8px !important;
  line-height: 1.1 !important;
  font-weight: 900 !important;
  color: var(--ink) !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
}

.topic-blob-label p {
  margin: 0 !important;
  font-size: 9px !important;
  font-weight: 850 !important;
  color: var(--ink-faint) !important;
  white-space: nowrap !important;
}

.topic-blob-shape {
  margin-top: 4px !important;
}

.topic-blob-shape img {
  width: 19% !important;
  max-width: 34px !important;
  border-radius: 5px !important;
  border-width: 2px !important;
  box-shadow: 0 3px 7px rgba(28, 36, 52, 0.16) !important;
}

.topic-blob-shape img.hero {
  width: 27% !important;
  max-width: 46px !important;
}


/* 5) Grid fallback: smaller photos + better names */

.cluster-canvas {
  grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
  gap: 8px !important;
  max-height: 225px !important;
  overflow: auto !important;
  padding: 4px !important;
}

.topic-bubble,
.cluster-zoom-1 .topic-bubble,
.cluster-zoom-2 .topic-bubble,
.cluster-zoom-3 .topic-bubble {
  height: 88px !important;
  min-height: 88px !important;
  padding: 7px !important;
  border-radius: 14px !important;
  display: grid !important;
  grid-template-rows: auto 1fr !important;
  gap: 5px !important;
  background: var(--paper-raised) !important;
}

.topic-title {
  order: 1 !important;
  display: grid !important;
  grid-template-columns: 8px 1fr !important;
  gap: 6px !important;
  align-items: start !important;
  padding: 0 !important;
  border-top: none !important;
  background: transparent !important;
}

.topic-title .topic-dot {
  width: 7px !important;
  height: 7px !important;
  margin-top: 3px !important;
}

.topic-title h3 {
  margin: 0 !important;
  color: var(--ink) !important;
  font-size: 9.4px !important;
  line-height: 1.12 !important;
  font-weight: 900 !important;
  letter-spacing: -0.05px !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  display: block !important;
}

.topic-title p {
  margin: 1px 0 0 !important;
  color: var(--ink-soft) !important;
  font-size: 9px !important;
  font-weight: 850 !important;
}

.topic-image-cloud {
  order: 2 !important;
  position: static !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 4px !important;
  min-height: 0 !important;
  background: transparent !important;
  overflow: hidden !important;
  padding: 0 !important;
}

.topic-image-cloud img,
.topic-image-cloud img:first-child,
.topic-image-cloud img:nth-child(2),
.topic-image-cloud img:nth-child(3),
.cluster-zoom-3 .topic-image-cloud img:nth-child(2),
.cluster-zoom-3 .topic-image-cloud img:nth-child(3) {
  position: static !important;
  display: block !important;
  width: 28px !important;
  height: 21px !important;
  object-fit: cover !important;
  border-radius: 5px !important;
  border: 2px solid var(--paper-raised) !important;
  box-shadow: 0 3px 7px rgba(28, 36, 52, 0.16) !important;
  transform: none !important;
}

.topic-image-cloud img:nth-child(n + 4),
.cluster-zoom-3 .topic-image-cloud img:nth-child(4) {
  display: none !important;
}


/* 6) Compact selected cluster strip */

.cluster-members-bar {
  margin-top: 10px !important;
  padding: 8px 10px !important;
  min-height: 40px !important;
}

.cluster-members-bar h3 {
  font-size: 12px !important;
}

.cluster-members-bar p {
  font-size: 10px !important;
}

.cluster-member-strip button {
  width: 38px !important;
  height: 28px !important;
}

.cluster-member-actions button {
  width: 25px !important;
  height: 25px !important;
}


@media (max-width: 1400px) {
  .cluster-canvas {
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    max-height: 235px !important;
  }

  .cluster-blob-field {
    grid-template-columns: repeat(auto-fill, minmax(145px, 1fr)) !important;
    max-height: 260px !important;
  }
}

/* === CLEAN MAP LEGEND CLUSTERS LIST END === */

/* === CLUSTER NAMES ONLY START === */

/* Keep cluster cards same size, remove inner images, show cleaner names */

.topic-image-cloud,
.topic-blob-shape,
.cluster-sample-grid,
.cluster-sample-grid img,
.topic-blob img,
.topic-bubble img {
  display: none !important;
}

/* same size as current cards, but cleaner */
.topic-bubble,
.topic-blob,
.topic-blob.blob-large,
.cluster-overview-card {
  min-height: 150px !important;
  height: 150px !important;
  padding: 16px 18px !important;
  border-radius: 22px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  background: #ffffff !important;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06) !important;
  overflow: hidden !important;
}

/* center title content */
.topic-title,
.topic-blob-label,
.cluster-card-title {
  width: 100% !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: center !important;
  justify-content: center !important;
  text-align: center !important;
  gap: 8px !important;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
  border: none !important;
}

/* color dot */
.topic-title .topic-dot,
.topic-blob-label .topic-dot {
  width: 11px !important;
  height: 11px !important;
  border-radius: 50% !important;
  display: inline-block !important;
  margin: 0 auto !important;
  flex-shrink: 0 !important;
}

/* cluster name */
.topic-title h3,
.topic-blob-label h3,
.cluster-card-title h3 {
  margin: 0 !important;
  font-size: 18px !important;
  line-height: 1.22 !important;
  font-weight: 850 !important;
  letter-spacing: -0.02em !important;
  color: #1f2937 !important;
  text-align: center !important;
  white-space: normal !important;
  overflow: visible !important;
  text-overflow: unset !important;
  max-width: 100% !important;
  display: block !important;
}

/* count */
.topic-title p,
.topic-blob-label p,
.cluster-card-title span {
  margin: 0 !important;
  font-size: 14px !important;
  line-height: 1.2 !important;
  font-weight: 750 !important;
  color: #6b7280 !important;
  text-align: center !important;
}

/* remove annoying cluster zoom controls */
.cluster-zoom-control,
.cluster-map-toolbar,
.cluster-zoom-caption,
.view-mode-toggle {
  display: none !important;
}

/* hide Postcards List */
.list-section {
  display: none !important;
}

/* map legend: keep only origin / receiving */
.map-overlay-legend-head,
.map-overlay-legend > strong,
.map-overlay-legend > div:not(.direction-legend) {
  display: none !important;
}

.map-overlay-legend {
  width: auto !important;
  min-width: 170px !important;
  max-width: 190px !important;
  padding: 9px 12px !important;
  border-radius: 999px !important;
}

.map-overlay-legend .direction-legend {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 14px !important;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
}

/* remove route shown + map semantic zoom */
.route-limit-control,
.map-semantic-zoom-note {
  display: none !important;
}

@media (max-width: 1400px) {
  .topic-title h3,
  .topic-blob-label h3,
  .cluster-card-title h3 {
    font-size: 16px !important;
  }

  .topic-title p,
  .topic-blob-label p,
  .cluster-card-title span {
    font-size: 13px !important;
  }
}

@media (max-width: 1100px) {
  .topic-bubble,
  .topic-blob,
  .topic-blob.blob-large,
  .cluster-overview-card {
    min-height: 136px !important;
    height: 136px !important;
    padding: 14px !important;
  }

  .topic-title h3,
  .topic-blob-label h3,
  .cluster-card-title h3 {
    font-size: 15px !important;
  }
}

/* === CLUSTER NAMES ONLY END === */
